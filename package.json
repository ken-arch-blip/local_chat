{
  "name": "huddle",
  "version": "1.0.0",
  "description": "A small self-hosted chat server for you and your friends. Text channels, voice rooms, DMs.",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
